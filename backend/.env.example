# ==========================================
# MathQuest Environment Configuration
# ==========================================

PROJECT_NAME=MathQuest
ENVIRONMENT=development
API_V1_STR=/api/v1

# JWT Security
# Generate a secure 32+ character key for production
SECRET_KEY=mathquest-super-secure-secret-key-at-least-32-chars-stream-2026-27
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Database Connection (Supabase / PostgreSQL)
# ==========================================
# For local development with SQLite (default):
DATABASE_URL=sqlite:///./mathquest.db

# For Supabase PostgreSQL (replace with your Supabase DB credentials):
# Direct connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler connection (recommended for cloud):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

