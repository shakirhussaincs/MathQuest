{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "entrypoint": "main:app",
      "root": "backend",
      "framework": "fastapi",
      "bindings": []
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci && chmod +x ./node_modules/.bin/vite && npm run build",
      "bindings": []
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}