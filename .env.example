# .env example for MathQuest
# Replace the placeholders with your actual Supabase credentials.

# PostgreSQL connection string for SQLAlchemy (used by FastAPI)
# Example: postgres://postgres:mySecretPass@db.dabc123.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase client (optional) – public anon key or service role key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

